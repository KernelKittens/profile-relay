# Required only when config/site.json uses the local provider.
# Generate at least 32 random characters. The same token goes in the connector config.
BIOCTL_BRIDGE_TOKEN=

# Set true only when the app is behind a trusted reverse proxy that replaces
# X-Forwarded-For. Direct clients must not be able to set that header.
BIOCTL_TRUST_PROXY=false

# Required only for the matching cloud provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Generic OpenAI-compatible provider. Remote endpoints must use HTTPS.
BIOCTL_COMPATIBLE_BASE_URL=
BIOCTL_COMPATIBLE_API_KEY=

# Published host port.
BIOCTL_PORT=3000

# Connector-only values can also be saved through /connect in the CLI.
BIOCTL_SITE_URL=
BIOCTL_CONNECTOR_ID=
BIOCTL_MODEL_ENDPOINT=http://127.0.0.1:11434
BIOCTL_MODELS=llama3.2

# Optional Tailscale container settings.
TS_AUTHKEY=
TS_HOSTNAME=bioctl
